# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# SAP / Web Portal Credentials
SAP_URL=http://report.maycha.com.vn/reports/browse
SAP_USERNAME=your_username
SAP_PASSWORD=your_password

# Playwright Settings
HEADLESS=true
DOWNLOAD_DIR=downloads

# Cron Schedule Expression (Linux cron: minute hour day-of-month month day-of-week)
# Mặc định: Chạy lúc 08:00 sáng mỗi ngày từ thứ 2 đến thứ 6
CRON_SCHEDULE=0 8 * * 1-5
